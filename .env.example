# Copiá este archivo a ".env" y ajustá los valores que quieras redefinir.
# Si no existe ".env", docker-compose.yml usa estos mismos defaults via ${VAR:-default}.

# --- Puerto host (la imagen y el nombre son fijos en docker-compose.yml) ---
HOST_HTTP_PORT=80

# --- Config nginx (las consume el template via envsubst) ---
GYM_PRIMARY_DOMAIN=localhost
GYM_APP_DOMAIN=localhost
GYM_API_UPSTREAM=fitnessgym_api:5274
GYM_FRONTEND_UPSTREAM=fitnessgym_frontend:5062
GYM_SSL_DHPARAM=/etc/nginx/ssl/dhparam.pem
GYM_CLIENT_MAX_BODY_SIZE=100M

# --- Red externa (la declara el compose de la app) ---
EXTERNAL_NETWORK=fitnessgym-net
