# Copiá este archivo a ".env" y ajustá los valores que quieras redefinir.
# Si no existe ".env", docker-compose.nginx.installer.dev.yml usa estos mismos defaults via ${VAR:-default}.

# --- Puerto host (la imagen y el nombre son fijos en docker-compose.nginx.installer.dev.yml) ---
HOST_HTTP_PORT=80

# --- Config nginx (las consume el template via envsubst) ---
GYM_PRIMARY_DOMAIN=localhost
GYM_APP_DOMAIN=localhost
GYM_API_UPSTREAM=fitnessgym_api:5274
GYM_FRONTEND_UPSTREAM=fitnessgym_frontend:5062

# --- SSL (opcional; las rutas son internas al contenedor) ---
# En desarrollo pueden dejarse sin definir y Nginx usará solo HTTP.
GYM_SSL_CERT=/etc/letsencrypt/live/ahlaradev.website/fullchain.pem
GYM_SSL_KEY=/etc/letsencrypt/live/ahlaradev.website/privkey.pem
GYM_SSL_DHPARAM=/etc/nginx/ssl/dhparam.pem
# Directorio de certificados en host y contenedor (Compose de producción).
GYM_SSL_CERTS_HOST_PATH=/etc/letsencrypt
GYM_SSL_CERTS_CONTAINER_PATH=/etc/letsencrypt
# Ruta del host que se monta en GYM_SSL_DHPARAM (solo Compose de producción).
GYM_SSL_DHPARAM_HOST_PATH=/etc/nginx/ssl/dhparam.pem

GYM_CLIENT_MAX_BODY_SIZE=100M

# --- Red externa (la declara el compose de la app) ---
EXTERNAL_NETWORK=fitnessgym-net
