user www-data;
worker_processes auto;

pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    keepalive_timeout 65;
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    # DNS embebido de Docker (ver README)
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 80;
        listen [::]:80;
        server_name ${GYM_PRIMARY_DOMAIN} _;

        access_log /var/log/nginx/dotnet-app-access.log;
        error_log  /var/log/nginx/dotnet-app-error.log;

        client_max_body_size ${GYM_CLIENT_MAX_BODY_SIZE};

        set $api_upstream ${GYM_API_UPSTREAM};
        set $frontend_upstream ${GYM_FRONTEND_UPSTREAM};

        # -----------------------------
        # SignalR (WebSockets)
        # -----------------------------
        location /reservacionesHub {
            proxy_pass http://$api_upstream;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # -----------------------------
        # API Backend
        # -----------------------------
        location /api {
            proxy_pass http://$api_upstream;

            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # -----------------------------
        # Health Check (Frontend)
        # -----------------------------
        location /health {
            proxy_pass http://$frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "keep-alive";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_cache_bypass $http_upgrade;
            proxy_buffering off;
        }

        # -----------------------------
        # App principal .NET
        # -----------------------------
        location / {
            proxy_pass http://$frontend_upstream;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "keep-alive";

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_cache_bypass $http_upgrade;
            proxy_buffering off;

            proxy_connect_timeout 20s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;
        }
    }
}
